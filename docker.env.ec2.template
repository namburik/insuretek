# EC2 production environment
# Copy to docker.env.ec2, fill in secrets — this file is gitignored

DB_TYPE=dynamodb
# No DYNAMODB_ENDPOINT — SDK uses real AWS via EC2 IAM instance profile
AWS_REGION=us-east-1

NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://793914a3.databases.neo4j.io
NEO4J_USER=793914a3
NEO4J_DATABASE=793914a3
NEO4J_PASSWORD=FILL_IN

MODEL_PROVIDER=google
GOOGLE_API_KEY=FILL_IN
GOOGLE_LLM_MODEL=gemini-2.5-flash
GOOGLE_RESOLVER_LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_CHAT_LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

LLM_TEMPERATURE=0

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8070
MCP_KG_PORT=8092
MCP_WORKFLOW_PORT=8093

# Inter-container service names
MCP_CORE_URL=http://mcp-core:8070/mcp_paytek
mcp_semantic_SERVER_URL=http://mcp-semantic:8092/mcp_semantic
mcp_workflow_SERVER_URL=http://mcp-workflow:8093/mcp_workflow

# web container is on port 80 externally; internally still 5000
WORKFLOW_API_BASE_URL=http://web:5000
GATE_CHECK_MOCK_BASE_URL=http://web:5000

GUARDIAN_ENABLED=false
HEALTH_CHECK_ON_AGENT_START=false

LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=paytek

