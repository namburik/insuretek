# Docker-specific overrides — host/port references rewritten to container names

DB_TYPE=dynamodb
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

NEO4J_ENABLED=true
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jneo4j
NEO4J_DATABASE=insuretek

MODEL_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_LLM_MODEL=gemini-2.5-flash
GOOGLE_RESOLVER_LLM_MODEL=gemini-2.5-flash
GOOGLE_CHAT_LLM_MODEL=gemini-3.1-flash-lite

# AWS Bedrock (set MODEL_PROVIDER=bedrock to activate; uses separate keys, DynamoDB local unaffected)
# BEDROCK_AWS_ACCESS_KEY_ID=<real-key>
# BEDROCK_AWS_SECRET_ACCESS_KEY=<real-secret>
# BEDROCK_LLM_MODEL=us.amazon.nova-2-lite-v1:0
# BEDROCK_RESOLVER_LLM_MODEL=us.amazon.nova-pro-v1:0
# BEDROCK_CHAT_LLM_MODEL=us.amazon.nova-2-lite-v1:0
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

LLM_TEMPERATURE=0

# Services bind on 0.0.0.0 inside containers
SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8070
MCP_KG_PORT=8092
MCP_WORKFLOW_PORT=8093

# Inter-container URLs use service names
MCP_CORE_URL=http://mcp-core:8070/mcp_core
MCP_AGENT_SERVER_URL=http://mcp-semantic:8092/mcp_semantic
mcp_workflow_SERVER_URL=http://mcp-workflow:8093/mcp_workflow

WORKFLOW_API_BASE_URL=http://web:6001
GATE_CHECK_MOCK_BASE_URL=http://web:6001

GUARDIAN_ENABLED=false
HEALTH_CHECK_ON_AGENT_START=false

LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
